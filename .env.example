# Company Brain — docker-compose configuration.
# Copy this file to ".env" (next to docker-compose.yml) and fill in the values.
#   cp .env.example .env
#
# =============================================================================
# CREDENTIALS YOU MUST FILL IN
# =============================================================================

# 1) OpenAI API key — REQUIRED. Used for embeddings (text-embedding-3-small)
#    and LLM calls (gpt-4o-mini). Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=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

# 2) Neo4j password — REQUIRED. Choose any non-default password; it is applied
#    to the neo4j container AND used by the API to connect. (Username is always
#    "neo4j" and is set automatically.)
NEO4J_PASSWORD=companyBrain

# =============================================================================
# CREDENTIALS WITH SAFE DEFAULTS (override only if you want to)
# =============================================================================

# 3) Postgres password — OPTIONAL. Defaults to "companybrain" if left unset.
#    Used both to initialise the postgres container and build POSTGRES_URL.
POSTGRES_PASSWORD=companybrain

# =============================================================================
# TUNABLES (optional — defaults shown)
# =============================================================================
CHUNK_GAP_MINUTES=30
CHUNK_MAX_TOKENS=800
SPEAKER_SIMILARITY_THRESHOLD=85
# Min cosine similarity (0-1) for a chunk to be retrieved. text-embedding-3-small
# scores short chat lines ~0.3-0.5, so keep this low (0.75 rejects valid matches).
RETRIEVAL_SIMILARITY_THRESHOLD=0.3
RETRIEVAL_CHUNK_LIMIT=5

# -----------------------------------------------------------------------------
# NOT NEEDED HERE (managed by docker-compose, listed for reference):
#   POSTGRES_URL   -> postgresql+asyncpg://companybrain:<pw>@postgres:5432/companybrain
#   NEO4J_URI      -> bolt://neo4j:7687
#   NEO4J_USERNAME -> neo4j
# -----------------------------------------------------------------------------
