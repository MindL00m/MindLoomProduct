# ---- Secrets / environment ----
# Never commit real credentials. Commit *.example templates instead.
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*credentials*.json
*service-account*.json
secrets/
**/secrets/

# ---- Legacy / local-only trees ----
# Orphan local folder (not part of the apps/ monorepo layout).
/backend/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ---- Node / frontend ----
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Packaged macOS agent copied into the web app for download.
# Force-add the zip if you want Railway/Git deploys to include it, or host it
# separately and set VITE_DESKTOP_AGENT_DOWNLOAD_URL.
apps/web/public/downloads/*.zip

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
.cursor/

# ---- Logs ----
*.log
logs/

# ---- Blob storage (raw uploaded source files) ----
data/blobs/
**/data/blobs/

# Approved screenshots and AI summaries are private runtime data.
apps/api/data/captures/*
!apps/api/data/captures/.gitkeep
