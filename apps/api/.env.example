# OpenAI
OPENAI_API_KEY=sk-your-openai-key
# Optional bearer token used by an admin-configured OpenAI-compatible local endpoint.
# Local servers that ignore authentication can keep the default value.
LOCAL_LLM_API_KEY=local
LOCAL_LLM_TIMEOUT_SECONDS=60

# PostgreSQL (pgvector enabled). An async driver URL is recommended, e.g.
#   postgresql+asyncpg://user:password@localhost:5432/company_brain
# A plain postgresql:// URL is also accepted and upgraded to asyncpg automatically.
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/company_brain

# Durable background worker queue (+ rate-limit storage)
REDIS_URL=redis://localhost:6379/0

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=please-change-me

# App environment and MindLoom access JWTs
# APP_ENV=production disables connect-dev/docs/graph-debug, requires strong secrets,
# and fail-closes webhook verification.
APP_ENV=development
SESSION_SECRET=replace-with-a-long-random-value
SESSION_TTL_HOURS=168
# Only honored when APP_ENV=development
ALLOW_DEV_INTEGRATIONS=true

# Tuning (optional, defaults shown)
CHUNK_GAP_MINUTES=30
CHUNK_MAX_TOKENS=800
SPEAKER_SIMILARITY_THRESHOLD=85

# Blob storage for raw uploaded source files and capture images.
# Compose default is local (+ volumes). Multi-replica / durable: set s3 + bucket.
BLOB_STORAGE_BACKEND=local
BLOB_STORAGE_ROOT=./data/blobs
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=   # optional: MinIO / R2; leave empty for AWS
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Legacy local root (read shim for pre-migration capture JSONL only).
CAPTURE_STORAGE_ROOT=./data/captures
CAPTURE_VISION_MODEL=gpt-4o-mini
# Email attachments (PDF, Word, Excel, PowerPoint, CSV, text) are always read.
# When true, scanned PDFs and image attachments are also transcribed with
# CAPTURE_VISION_MODEL (an OpenAI call per scanned file).
EMAIL_ATTACHMENT_OCR=true

# Web search (Tavily, https://tavily.com). When set, Ask and workspace Loombot fall
# back to a web search for low-confidence answers that are about public
# information, and answer explicit "search the web" requests. Every answer that
# used the web is labelled. Internal company questions are never sent. Leave
# empty to turn web search off.
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true

# Default chat model (Ask, ingestion metadata extraction, query rewriting,
# workspace CONTEXT.md). An org's saved LLM settings override it for Ask.
OPENAI_DEFAULT_MODEL=gpt-6-luna

# Model mixing for Ask and workspace Loombot. A cheap router model rates each
# question simple, moderate, or complex, and each tier uses its own model and
# reasoning effort. Applies to orgs on OpenAI with the default model above; an
# admin-pinned or local model is always kept. An unknown tier model falls back
# to the default. The router model also checks suspected knowledge conflicts.
MODEL_ROUTING_ENABLED=true
MODEL_ROUTER_MODEL=gpt-6-luna
MODEL_SIMPLE=gpt-6-luna
MODEL_SIMPLE_REASONING=none
MODEL_MODERATE=gpt-6-luna
MODEL_MODERATE_REASONING=low
MODEL_COMPLEX=gpt-6-sol
MODEL_COMPLEX_REASONING=medium

# Fernet key for OAuth tokens at rest (required in production).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Google Workspace OAuth (Drive, Gmail, and Calendar) + Google sign-in (GIS)
# Scopes requested: Gmail read + send, Drive read, Calendar read, and Calendar
# events (to schedule meetings the user approves). Add the calendar.events scope to
# the OAuth consent screen; existing users reconnect once to grant it.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable the Drive, Gmail, and Calendar APIs for your project.
# GOOGLE_CLIENT_ID is also the audience for Google Identity Services ID tokens.
# The authorized redirect URI must match GOOGLE_WORKSPACE_OAUTH_REDIRECT_URI.
# Authorized JavaScript origins must include the web app origin for GIS sign-in.
# For local web (`npm run dev`), also set VITE_GOOGLE_CLIENT_ID to the same value
# in apps/web/.env.local (Compose build passes GOOGLE_CLIENT_ID automatically).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/google/workspace/callback
GOOGLE_PUBSUB_TOPIC=
GOOGLE_DRIVE_WEBHOOK_URL=
GOOGLE_DRIVE_WEBHOOK_SECRET=replace-with-a-long-random-value
# Full HTTPS URL of POST /webhooks/google/pubsub (OIDC audience). Required in production.
GOOGLE_PUBSUB_PUSH_AUDIENCE=

# Zoom cloud recording knowledge
# Register the callback and /webhooks/zoom endpoint in a Zoom General App.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/zoom/callback
ZOOM_WEBHOOK_SECRET_TOKEN=

# Microsoft Entra / Teams
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/microsoft/teams/callback
MICROSOFT_GRAPH_WEBHOOK_URL=
# Required in production; never use "dev-client-state"
MICROSOFT_GRAPH_CLIENT_STATE=

# Public API origin Slack uses to deliver Events API callbacks.
# Production: https://api.example.com
# Locally Slack cannot reach localhost. Run a tunnel and paste its HTTPS address:
#   cloudflared tunnel --url http://localhost:8000
PUBLIC_API_URL=http://localhost:8000

# Frontend origin for OAuth redirects + CORS primary origin.
# Production: set FRONTEND_URL to the public HTTPS web origin.
# Register provider redirect URIs to the public API host:
#   GOOGLE_WORKSPACE_OAUTH_REDIRECT_URI, MICROSOFT_OAUTH_REDIRECT_URI, ZOOM_OAUTH_REDIRECT_URI
# Compose UI defaults VITE_API_BASE=/api (nginx same-origin proxy). For a separate
# API host, bake VITE_API_BASE=https://api.example.com when building apps/web.
# Never point an HTTPS UI at an HTTP API (mixed content).
# Compose serves the UI on :5500; Vite dev often uses :5173 (add via CORS_ALLOWED_ORIGINS).
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5500

# Optional: override Compose frontend bake (default /api).
# VITE_API_BASE=/api

# Optional. Public URL for the macOS agent zip if it is not served from
# the frontend image at /downloads/LoomCapture-macos.zip.
# VITE_DESKTOP_AGENT_DOWNLOAD_URL=

# Inbound rate limits (slowapi strings)
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_QUERY=30/minute
RATE_LIMIT_CAPTURES=30/minute
RATE_LIMIT_INGEST=20/minute

# GitHub (per-user connector in Apps — not a server-wide token)
# Create a fine-grained PAT and paste it in the web app. Choose repositories
# and actions (metadata / file contents / pull requests) there.
# GITHUB_TOKEN=
