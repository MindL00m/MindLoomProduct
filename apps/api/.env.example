# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# PostgreSQL (pgvector enabled). An async driver URL is recommended, e.g.
#   postgresql+asyncpg://user:password@localhost:5432/company_brain
# A plain postgresql:// URL is also accepted and upgraded to asyncpg automatically.
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/company_brain

# Durable background worker queue
REDIS_URL=redis://localhost:6379/0

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=please-change-me

# Tuning (optional, defaults shown)
CHUNK_GAP_MINUTES=30
CHUNK_MAX_TOKENS=800
SPEAKER_SIMILARITY_THRESHOLD=85

# Blob storage for raw uploaded source files (citation originals).
# Only the local filesystem backend is implemented today.
BLOB_STORAGE_BACKEND=local
BLOB_STORAGE_ROOT=./data/blobs

# Approved browser captures are kept by the main Loom API.
CAPTURE_STORAGE_ROOT=./data/captures
CAPTURE_VISION_MODEL=gpt-4o-mini

# Google Workspace OAuth (Drive, Gmail, and Calendar)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable the Drive, Gmail, and Calendar APIs for your project.
# The authorized redirect URI must match GOOGLE_WORKSPACE_OAUTH_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/google/workspace/callback
GOOGLE_PUBSUB_TOPIC=
GOOGLE_DRIVE_WEBHOOK_URL=
GOOGLE_DRIVE_WEBHOOK_SECRET=replace-with-a-long-random-value

# Zoom cloud recording knowledge
# Register the callback and /webhooks/zoom endpoint in a Zoom General App.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/zoom/callback
ZOOM_WEBHOOK_SECRET_TOKEN=

# Microsoft Entra / Teams
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/microsoft/teams/callback
MICROSOFT_GRAPH_WEBHOOK_URL=
MICROSOFT_GRAPH_CLIENT_STATE=dev-client-state
FRONTEND_URL=http://localhost:5173
