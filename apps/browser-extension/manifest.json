{
  "manifest_version": 3,
  "name": "MindLoom Capture",
  "version": "1.6.0",
  "description": "Turns approved Chrome screenshot sessions into reviewable MindLoom Skill Files, and does their steps on the sites you allow when you run one.",
  "permissions": ["tabs", "activeTab", "scripting", "storage", "debugger", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["anchor.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MindLoom Capture"
  }
}
