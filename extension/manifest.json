{
  "manifest_version": 3,
  "name": "workstyle-capture",
  "version": "1.3.1",
  "description": "Tracks the active browser tab for workstyle capture.",
  "permissions": ["tabs", "activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "workstyle-capture"
  }
}
